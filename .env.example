# Frontend Supabase config
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Frontend escrow config
VITE_ESCROW_LAUNCH_ENDPOINT="https://sorsa-official-production.up.railway.app/campaigns/launch"
VITE_ESCROW_CONTRACT_ADDRESS="0xYourEscrowContract"
VITE_USDC_ADDRESS="0xYourUSDCContract"
VITE_ESCROW_CHAIN_ID="84532"
VITE_ESCROW_RPC_URL="https://sepolia.base.org"

# Server escrow config. Keep PLATFORM_PRIVATE_KEY and service role keys server-only.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
ESCROW_RPC_URL="https://sepolia.base.org"
ESCROW_CHAIN_ID="84532"
ESCROW_CONTRACT_ADDRESS="0xYourEscrowContract"
PLATFORM_PRIVATE_KEY="0xyour_platform_private_key"
PORT="8787"
ALLOWED_ORIGINS="http://localhost:3000"

# Server-only Sorsa API config. Do not expose these with VITE_.
SORSA_API_BASE="https://api.sorsa.io/v3"
SORSA_API_KEY="your_sorsa_api_key"
# Keep false while Sorsa API tokens are unavailable so stored creator scores remain unchanged.
SORSA_PROFILE_SYNC_ENABLED="false"
CREATOR_IDENTITY_SYNC_ENABLED="true"
CREATOR_IDENTITY_SYNC_INTERVAL_DAYS="4"

# Server-only Telegram bot config. Do not expose TELEGRAM_BOT_TOKEN with VITE_.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_BOT_USERNAME="your_bot_username"
TELEGRAM_WEBHOOK_SECRET="your_random_webhook_secret"
TELEGRAM_RAFFLE_GROUP_CHAT_ID="-1001234567890"
TELEGRAM_RAFFLE_GROUP_THREAD_ID="6"
TELEGRAM_NFT_LAUNCH_GROUP_THREAD_ID="3"
TELEGRAM_CONNECT_CODE_TTL_MINUTES="30"
APP_SESSION_TTL_DAYS="90"
FRONTEND_URL="https://your-frontend-domain.com"
NFT_CAMPAIGN_ASSET_BUCKET="nft-campaign-assets"
PAYOUT_AUTOMATION_ENABLED="true"
PAYOUT_POLL_INTERVAL_SECONDS="300"
PAYOUT_MAX_PAYMENTS_PER_TX="50"
SUBMISSION_WINDOW_NOTIFICATIONS_ENABLED="true"
SUBMISSION_WINDOW_POLL_INTERVAL_SECONDS="300"

# WalletConnect / RainbowKit
VITE_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id"

# Legacy AI Studio values, only needed if the app still uses those integrations.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
